<IfModule mod_rewrite.c>
   RewriteEngine On
   
   # Force HTTPS unless already behind a TLS-terminating proxy
   RewriteCond %{HTTPS} !=on
   RewriteCond %{HTTP:X-Forwarded-Proto} !=https
   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

   # Redirect root to public/ subdirectory
   RewriteCond %{REQUEST_URI} !^/public/
   RewriteRule ^(.*)$ public/$1 [L]

   # Ensure bots can see the privacy policy
   SetEnvIf User-Agent ^facebookexternalhit facebook_bot
   SetEnvIf User-Agent ^Facebot facebook_bot

</IfModule>
